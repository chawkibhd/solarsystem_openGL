{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build OpenGL",
            "type": "shell",
            "command": "clang++",
            "args": [
                "main.cpp",
                "-o",
                "main",
                "-I/opt/homebrew/include",
                "-L/opt/homebrew/lib",
                "-lglut",
                "-framework",
                "OpenGL"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang générer le fichier actif",
            "command": "/usr/bin/clang",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tâche générée par le débogueur."
        }
    ]
}